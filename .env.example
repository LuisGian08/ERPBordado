# Copia a .env y sustituye las claves antes de iniciar el sistema.
SPRING_PROFILES_ACTIVE=docker

# PostgreSQL (valores de desarrollo; cambiar tambien los SQL init scripts).
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_ROOT_USER=postgres
POSTGRES_ROOT_PASSWORD=postgres_secure_root_password_change_me

DB_DISENOS_NAME=embroidery_disenos
DB_DISENOS_USER=disenos_user
DB_DISENOS_PASSWORD=disenos_pass_dev_secret
DB_INVENTARIO_NAME=embroidery_inventario
DB_INVENTARIO_USER=inventario_user
DB_INVENTARIO_PASSWORD=inventario_pass_dev_secret
DB_TRABAJOS_NAME=embroidery_trabajos
DB_TRABAJOS_USER=trabajos_user
DB_TRABAJOS_PASSWORD=trabajos_pass_dev_secret
DB_PAGOS_NAME=embroidery_pagos
DB_PAGOS_USER=pagos_user
DB_PAGOS_PASSWORD=pagos_pass_dev_secret
DB_AUTH_NAME=embroidery_auth
DB_AUTH_USER=auth_user
DB_AUTH_PASSWORD=auth_pass_dev_secret

# Primer administrador: ADMIN_PASSWORD debe tener 12-72 caracteres.
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=Administrador
ADMIN_PASSWORD=

# Cuentas de prueba para ADMIN, DISENADOR y OPERADOR (solo desarrollo).
TEST_ADMIN_USERNAME=prueba_admin
TEST_ADMIN_PASSWORD=
TEST_COMPANY_ADMIN_USERNAME=prueba_admin_empresa
TEST_COMPANY_ADMIN_PASSWORD=
TEST_DESIGNER_USERNAME=prueba_disenador
TEST_DESIGNER_PASSWORD=
TEST_OPERATOR_USERNAME=prueba_operador
TEST_OPERATOR_PASSWORD=

# JWT_SECRET se firma con bytes UTF-8 crudos; usa al menos 32 caracteres.
# Generar una clave aleatoria con: openssl rand -hex 32
# El mismo valor exacto debe estar en todos los servicios.
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Si cambias DB_*_PASSWORD, cambia tambien las contrasenas equivalentes en
# infrastructure/docker/postgres/init-scripts/01-create-databases.sql.

PORT_GATEWAY=8095
PORT_DISENOS=8096
PORT_INVENTARIO=8097
PORT_TRABAJOS=8098
PORT_PAGOS=8099
PORT_AUTH=8100
PORT_PREVIEW=8101
# Generate a private random token, for example: openssl rand -hex 32
PREVIEW_INTERNAL_TOKEN=
MAX_TECHNICAL_FILE_MB=25
PORT_POSTGRES=5432
